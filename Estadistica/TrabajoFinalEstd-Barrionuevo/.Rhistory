quarto install tinytex
## Instalación y carga de librerías
library(dplyr)
##install.packages("lawstat")
library(lawstat)
##install.packages("GGally")
##install.packages("ggplot2")
library(GGally)
##install.packages("car")
library(car)
## Carga de los datos en una tabla
data_ndvi <- read.table("datos/ndvi_4_estaciones.txt")
## Mostrar head de la tabla
head(data_ndvi)
## Cuenta la cantidad de observaciones por estación
table(data_ndvi$estacion)
## Tabla de estadística descriptiva
data_ndvi %>%
group_by(estacion) %>%
summarise(
n = n(),
media = mean(ndvi),
de = sd(ndvi),
cv = sd(ndvi) / mean(ndvi) * 100,
min = min(ndvi),
max = max(ndvi)
)
## Graficar boxplot con librería por default
boxplot(ndvi ~ estacion, data = data_ndvi,
xlab = "Estación", ylab = "NDVI")
## Definir y ajustar el modelo para el test de ANOVA
fit <- aov(ndvi ~ estacion, data = data_ndvi)
## Mostrar un resumen del modelo ajustado
summary(fit)
## Test de Tukey para diferencia entre medias
tk <- TukeyHSD(fit)
tk
# Cambio de los labels comparación de estaciones
rownames(tk$estacion) <- c(
"O-I",
"P-I",
"V-I",
"P-O",
"V-O",
"V-P"
)
## Plot de los resultados del test de Tukey
plot(tk)
## Plot de los resultados del test de Tukey
plot(tk,
xlab = "Par estación", ylab = "IC dif. de medias")
# Cambio de los labels comparación de estaciones
rownames(tk$estacion) <- c(
"O-I",
"P-I",
"V-I",
"P-O",
"V-O",
"V-P"
)
## Plot de los resultados del test de Tukey
plot(tk,
xlab = "Par estación", ylab = "IC dif. de medias")
## Plot de los resultados del test de Tukey
plot(tk)
# Cambio de los labels comparación de estaciones
rownames(tk$estacion) <- c(
"O-I",
"P-I",
"V-I",
"P-O",
"V-O",
"V-P"
)
## Plot de los resultados del test de Tukey
plot(tk)
title(
xlab = "Diferencia de medias de NDVI",
ylab = "Comparación entre estaciones"
)
## Plot de los resultados del test de Tukey
plot(tk)
## Ploteo QQplot para evaluar normalidad de los residuos
qqnorm(rstandard(fit))
qqline(rstandard(fit))
## Test de Shapiro-Wilk para evaluar normalidad de los residuos
shapiro.test(rstandard(fit))
## Ploteo de gráfico de residuos estandarizados vs valores predichos para evaluar
## homogeneidad de varianzas
plot(fitted.values(fit), rstandard(fit),
xlab = "Valores predichos", ylab = "Residuos estandarizados")
## Ploteo de gráfico de residuos estandarizados vs valores predichos para evaluar
## homogeneidad de varianzas
"Nota: Cada población/tratamiento se ubica en el eje x según el valor de su media. Es decir
invierno: 0.2033
otono: 0.172
primavera: 0.2891
verano: 0.608
"
plot(fitted.values(fit), rstandard(fit),
xlab = "Valores predichos", ylab = "Residuos estandarizados")
## Test de Levene para evaluación de homogeneidad de varianzas
car::leveneTest(data_ndvi$ndvi, data_ndvi$estacion, center = mean)
