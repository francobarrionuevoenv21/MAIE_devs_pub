## Defino un primer modelo
model_1 <- lm(agua_eva ~ tpsuelma + tairemax, data = data_evap)
## Summary del modelo
summary(model_1)
coefficients(modelo_2)
coefficients(model_2)
coefficients(model_2)[1]
y_pred
## Guardo los beta del modelo ajustado
beta_0 <- coefficients(model_2)[1]
beta_1 <- coefficients(model_2)[2]
## Defino tpsuelma
x_pred <- 88 ## tpsuelma = 88°F
## Predicción
y_pred <- beta_0 + beta_1*x_pred
y_pred
