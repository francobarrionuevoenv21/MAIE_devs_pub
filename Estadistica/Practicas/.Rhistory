install.packages("dplyr")
## ----message=FALSE, echo = TRUE--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# install.packages("dplyr")
install.packages("ggplot2")
## ----message=FALSE, echo = TRUE--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# install.packages("dplyr")
# install.packages("ggplot2")
library(dplyr)
library(ggplot2)
## ----echo = TRUE, message=FALSE--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
datos_ndvi <- read.table("datos/ndvi_p.txt")
## --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
head(datos_ndvi)
## ----eval = with_answer, echo = with_answer--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
class(datos_ndvi$ndvi)
class(datos_ndvi$zona)
## ----eval = with_answer, echo = with_answer--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
summary(datos_ndvi)
## ----eval = with_answer, echo = with_answer--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
datos_ndvi %>%
summarise(
n = n(),
media = mean(ndvi),
varanza = var(ndvi),
de = sd(ndvi),
cv = sd(ndvi) / mean(ndvi) * 100,
EE = de / sqrt(n()),
p05 = quantile(ndvi, 0.05),
p25 = quantile(ndvi, 0.25),
p50 = quantile(ndvi, 0.50),
p75 = quantile(ndvi, 0.75),
p95 = quantile(ndvi, 0.95),
iqr = IQR(ndvi)
)
## ----eval = with_answer, echo = with_answer--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
table(datos_ndvi$zona)
datos_ndvi %>%
summarise(
n = n(),
media = mean(ndvi),
varanza = var(ndvi),
de = sd(ndvi),
cv = sd(ndvi) / mean(ndvi) * 100,
EE = de / sqrt(n()),
p05 = quantile(ndvi, 0.05),
p25 = quantile(ndvi, 0.25),
p50 = quantile(ndvi, 0.50),
p75 = quantile(ndvi, 0.75),
p95 = quantile(ndvi, 0.95),
iqr = IQR(ndvi)
)
ggplot(datos_ndvi, aes(x = ndvi)) +
geom_histogram(bins = 35) +
ylab("Frecuencia absoluta") +
xlab("NDVI")
ggplot(datos_ndvi, aes(x = ndvi)) +
geom_density() +
ylab("Frecuencia absoluta") +
xlab("NDVI")
ggplot(datos_ndvi, aes(x = ndvi)) +
stat_ecdf() +
ylab("Frecuencia relativa acumulada") +
xlab("NDVI")
ggplot(datos_ndvi, aes(y = ndvi)) +
geom_boxplot()
datos_ndvi %>%
group_by(zona) %>%
summarise(
n = n(),
media = mean(ndvi),
varanza = var(ndvi),
de = sd(ndvi),
cv = sd(ndvi) / mean(ndvi) * 100,
EE = de / sqrt(n()),
p05 = quantile(ndvi, 0.05),
p25 = quantile(ndvi, 0.25),
p50 = quantile(ndvi, 0.50),
p75 = quantile(ndvi, 0.75),
p95 = quantile(ndvi, 0.95),
iqr = IQR(ndvi)
)
ggplot(datos_ndvi, aes(x = ndvi, color = zona)) +
stat_ecdf() +
ylab("Frecuencia relativa acumulada") +
xlab("NDVI")
ggplot(datos_ndvi, aes(y = ndvi, x = zona)) +
geom_boxplot()
EE <- function(x) {
sd(x, na.rm = TRUE) / sqrt(length(complete.cases(x)))
}
ggplot(data = datos_ndvi) +
stat_summary(
aes(x = zona, y = ndvi),
fun.min = function(x) {
mean(x) - EE(x)
},
fun.max = function(x) {
mean(x) + EE(x)
},
fun = mean
) +
ylab("NDVI") +
xlab("Zona")
ggplot(data = datos_ndvi, aes(x = zona, y = ndvi)) +
stat_summary(
fun.data = mean_se
) +
ylab("NDVI") +
xlab("Zona")
ggplot(data = datos_ndvi, aes(x = zona, y = ndvi)) +
stat_summary(
fun.data = mean_se
) +
ylab("NDVI") +
xlab("Zona")
