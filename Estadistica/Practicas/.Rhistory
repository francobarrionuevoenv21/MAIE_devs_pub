EE <- function(x) {
sd(x, na.rm = TRUE) / sqrt(length(complete.cases(x)))
}
ggplot(data = datos_ndvi) +
stat_summary(
aes(x = zona, y = ndvi),
fun.min = function(x) {
mean(x) - EE(x)
},
fun.max = function(x) {
mean(x) + EE(x)
},
fun = mean
) +
ylab("NDVI") +
xlab("Zona")
ggplot(data = datos_ndvi, aes(x = zona, y = ndvi)) +
stat_summary(
fun.data = mean_se
) +
ylab("NDVI") +
xlab("Zona")
ggplot(data = datos_ndvi, aes(x = zona, y = ndvi)) +
stat_summary(
fun.data = mean_se
) +
ylab("NDVI") +
xlab("Zona")
